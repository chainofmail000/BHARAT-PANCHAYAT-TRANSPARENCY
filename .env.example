# Frontend (Create React App)
# Leave unset for local development; production/preview should use the deployed FastAPI URL.
REACT_APP_API_BASE_URL=http://127.0.0.1:8000

# Backend (FastAPI)
# Comma-separated exact origins; set this in the backend deployment environment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
